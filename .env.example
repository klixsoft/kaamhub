# Public URL of the application (no trailing slash)
APP_URL=http://localhost:3000

# PostgreSQL connection
DATABASE_URL=postgres://kaamhub:kaamhub@localhost:5432/kaamhub
DATABASE_POOL_MAX=10

# Signs sessions and derives internal tokens. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Encrypts stored credentials, email and GitHub secrets. Generate with: openssl rand -hex 32
# Keep a copy: encrypted values cannot be read without it.
ENCRYPTION_KEY=

# Where uploaded project documents are stored
STORAGE_DIR=./storage

# Email and GitHub are configured by a Super Admin in the app (Email and GitHub pages).
