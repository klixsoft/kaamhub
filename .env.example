# Public URL of the application (no trailing slash)
APP_URL=http://localhost:3000

# PostgreSQL connection
DATABASE_URL=postgres://kaamhub:kaamhub@localhost:5432/kaamhub
DATABASE_POOL_MAX=10

# Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=

# Outgoing email (optional in development: emails are printed to the server log)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="KaamHub <no-reply@example.com>"

# GitHub App (see docs/github.md)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=
GITHUB_ORG=
GITHUB_WEBHOOK_SECRET=
# OAuth credentials of the same GitHub App, used to link user accounts
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Self-update (see docs/deployment.md)
UPDATE_REPOSITORY=klixsoft/kaamhub
UPDATER_URL=http://updater:9000
# Generate with: openssl rand -hex 32
UPDATER_TOKEN=

# Daily jobs (recurring invoice drafts, renewal reminders). Generate with: openssl rand -hex 32
CRON_SECRET=
