# Copy to .env next to docker-compose.yml on your server and fill in every value.

# Images published by the release workflow (replace "owner" with your GitHub user or organisation)
APP_IMAGE=ghcr.io/klixsoft/kaamhub
APP_TAG=latest
UPDATER_IMAGE=ghcr.io/klixsoft/kaamhub-updater
UPDATER_TAG=latest

# Built-in HTTPS: set DOMAIN and COMPOSE_PROFILES=https to run Caddy with automatic certificates.
# Leave COMPOSE_PROFILES empty if you already run Nginx, Traefik or another proxy in front of APP_PORT.
COMPOSE_PROFILES=https
DOMAIN=hub.example.com

# Where the app listens on the host
APP_BIND=127.0.0.1
APP_PORT=3000
APP_URL=https://hub.example.com

# Database (the app connects to the bundled Postgres container)
POSTGRES_DB=kaamhub
POSTGRES_USER=kaamhub
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=

# Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=

# Outgoing email
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="KaamHub <no-reply@example.com>"

# GitHub App (see docs/github.md)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=
GITHUB_ORG=
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Self-update: the repository whose GitHub Releases are checked, and the shared updater secret
UPDATE_REPOSITORY=klixsoft/kaamhub
# Generate with: openssl rand -hex 32
UPDATER_TOKEN=

# Daily jobs (recurring invoice drafts, renewal reminders). Generate with: openssl rand -hex 32
CRON_SECRET=
