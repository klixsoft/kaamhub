# Copy to .env next to docker-compose.yml on your server and fill in every empty value.

# Images published with each release. Use an exact version such as 0.1.0 instead of latest to control upgrades.
APP_IMAGE=ghcr.io/klixsoft/kaamhub
APP_TAG=latest
UPDATER_IMAGE=ghcr.io/klixsoft/kaamhub-updater
UPDATER_TAG=latest

# Built-in HTTPS: set DOMAIN and COMPOSE_PROFILES=https to run Caddy with automatic certificates.
# Leave COMPOSE_PROFILES empty if you already run Nginx, Traefik or another proxy in front of APP_PORT.
COMPOSE_PROFILES=https
DOMAIN=hub.example.com

# Where the app listens on the host
APP_BIND=127.0.0.1
APP_PORT=3000
APP_URL=https://hub.example.com

# Database (the app connects to the bundled Postgres container)
POSTGRES_DB=kaamhub
POSTGRES_USER=kaamhub
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=

# Signs sessions and derives the updater and scheduled-job tokens. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Encrypts stored credentials, email and GitHub secrets. Generate with: openssl rand -hex 32
# Keep a copy: encrypted values cannot be read without it.
ENCRYPTION_KEY=

# Email and GitHub are configured by a Super Admin in the app (Email and GitHub pages).
